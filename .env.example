# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# Assay talks to any OpenAI-compatible chat-completions endpoint. That includes ilmu.ai, OpenAI
# itself, OpenRouter, Together, or a local vLLM / Ollama / LM Studio server — set the three
# variables below and nothing else changes.

# The provider used by default for every scored run.
ASSAY_PRIMARY_BASE_URL=https://api.ilmu.ai/v1
ASSAY_PRIMARY_API_KEY=
ASSAY_PRIMARY_MODEL=nemo-super

# A second provider, used to check whether the result holds on a stronger model. Select it per run
# with the ASSAY_PROVIDER shell variable — nothing here changes:
#
#   ASSAY_PROVIDER=frontier ASSAY_RUN_ID=k3 npm run eval
#
# It is a shell switch rather than a setting in this file on purpose: the scored configuration stays
# written down, and swapping models is an explicit act that shows up in shell history.
ASSAY_FRONTIER_BASE_URL=https://api.moonshot.ai/v1
ASSAY_FRONTIER_API_KEY=
ASSAY_FRONTIER_MODEL=kimi-k3
# kimi-k3 rejects temperature 0 and accepts only 1, so it cannot be run deterministically.
# Sampling settings can be overridden per provider with ASSAY_<PROVIDER>_TEMPERATURE.
ASSAY_FRONTIER_TEMPERATURE=1

# Optional secondary model. Used ONLY when ASSAY_ALLOW_FALLBACK=1, and any run that touches it is
# marked degraded in the report — see below.
ASSAY_FALLBACK_BASE_URL=https://api.ilmu.ai/v1
ASSAY_FALLBACK_API_KEY=
ASSAY_FALLBACK_MODEL=ilmu-nemo-nano

# Fallback is off by default and should stay off for any run you intend to report.
#
# The baseline and the agent must face the same model for the comparison to mean anything. If the
# primary dies halfway through and the harness quietly finishes on a smaller model, the headline
# number becomes a blend of two systems and is worthless — so the harness records the model that
# served every single call and refuses to publish a comparison built on mixed models.
#
# Set this to 1 only for exploratory runs where you would rather have partial results than none.
ASSAY_ALLOW_FALLBACK=0

# Determinism. Temperature 0 for every scored run.
ASSAY_TEMPERATURE=0
ASSAY_MAX_TOKENS=4096

# Optional. Only used to convert token counts into a USD figure in the report; leave unset to
# report tokens alone. USD per 1M tokens.
# ASSAY_PRICE_INPUT_PER_MTOK=0
# ASSAY_PRICE_OUTPUT_PER_MTOK=0

# --- Aliases -------------------------------------------------------------------------------
# If you already have these set from another project they will be picked up automatically, so you
# do not need to duplicate the values above.
#   AI_EXPLAIN_API_KEY / AI_EXPLAIN_BASE_URL / AI_EXPLAIN_MODEL      -> primary
#   AI_FALLBACK_API_KEY / AI_FALLBACK_BASE_URL / AI_FALLBACK_MODEL   -> fallback
